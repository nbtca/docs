{
  "name": "@nbtca/docs",
  "version": "0.2.3",
  "description": "Data-only library for the NBTCA documents repository",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "test": "vitest run",
    "precheck:package": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run check:package && npm audit --audit-level=moderate",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "nbtca",
    "documents",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbtca/docs.git"
  },
  "bugs": {
    "url": "https://github.com/nbtca/docs/issues"
  },
  "homepage": "https://github.com/nbtca/docs#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
